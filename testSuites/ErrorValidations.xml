<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression">
<groups>
	<run>
		<include name="ErrorValidations"/>
	</run>
</groups>
  <test thread-count="5" name="Positive">
    <classes>
      <class name="arijit.practice.PositiveTests"/>
    </classes>
  </test> <!-- Test -->
  
   <test thread-count="5" name="Negative">
    <classes>
      <class name="arijit.practice.ErrorValidation"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
